# Export these variables in the configured services; replace every placeholder.
# Obtain managed installation directories through your GPU helper's job-init.
RGBMOCAP_JOBS=/srv/training/jobs
RGBMOCAP_INSTALL=/srv/training/jobs/SET_EXMR_INSTALL_JOB
H3_INSTALL=/srv/training/jobs/SET_H3_INSTALL_JOB
H3_MODEL_INSTALL=/srv/training/jobs/SET_H3_MODEL_JOB
GPU_AGENT_HELPER=/absolute/path/to/gpu-agent.py
GPU_DASHBOARD_URL=http://127.0.0.1:8080
EXMR_ROOT=/absolute/path/to/ExMR
EXMR_PYTHON=/absolute/path/to/exmr-venv/bin/python
RGBMOCAP_CHECKPOINTS=/srv/training/jobs/SET_MODEL_JOB/checkpoints
BLENDER_BIN=/absolute/path/to/blender
JPEG_LIB=/absolute/path/to/libjpeg-turbo/lib64
RGBMOCAP_UI_PYTHON=/absolute/path/to/ui-venv/bin/python
H3_ROOT=/absolute/path/to/free-camera-mocap/integrations/h3
COMFYUI_ROOT=/absolute/path/to/ComfyUI
H3_PYTHON=/absolute/path/to/h3-venv/bin/python
H3_MODELS=/srv/training/jobs/SET_H3_MODEL_JOB/checkpoints/models
FACE_PYTHON=/absolute/path/to/face-venv/bin/python
FACE_MODELS=/srv/training/jobs/SET_FACE_MODEL_JOB/checkpoints/face
RGBMOCAP_DESKTOP_RESULTS=/absolute/path/to/Desktop/FreeCameraResults
